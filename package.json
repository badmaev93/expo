{
  "name": "exhibition-panel-builder",
  "productName": "EXPO Panel Studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Конструктор интерактивных панелей для выставок — schema-driven UI, плагинные виджеты, realtime WebSockets",
  "author": "badmaevoleg <badmaevoleg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/badmaev93/expo.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n \"WS,WEB\" -c \"magenta,cyan\" \"npm:server\" \"vite\"",
    "server": "node server/ws-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "cross-env DEPLOY_BASE=./ vite build --outDir dist-electron",
    "electron:dev": "concurrently -n \"WS,WEB,ELECTRON\" -c \"magenta,cyan,yellow\" \"npm:server\" \"vite\" \"cross-env ELECTRON_START_URL=http://localhost:5173/expo/ electron .\"",
    "electron:preview": "npm run build:electron && electron .",
    "dist:electron": "npm run build:electron && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.4.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "ws": "^8.17.1"
  },
  "build": {
    "appId": "kz.hlab.expo-panel-studio",
    "productName": "EXPO Panel Studio",
    "files": [
      "electron/**/*",
      "dist-electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "badmaev93",
      "repo": "expo"
    }
  }
}
